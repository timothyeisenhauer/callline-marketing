---
import Logo from './Logo.astro';

interface Props {
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="border-t bg-background">
  <div class:list={[containerClass, 'py-12']}>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <Logo />
        <p class="mt-4 text-sm text-muted-foreground">
          Business phone that feels handled. Calls, voicemails, and SMS in one dashboard.
        </p>
      </div>

      <div>
        <h3 class="font-semibold mb-4">Product</h3>
        <ul class="space-y-2">
          <li><a href="/#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a></li>
          <li><a href="/#pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
          <li><a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-4">Company</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-muted-foreground hover:text-foreground transition-colors">About</a></li>
          <li><a href="/contact" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-4">Legal</h3>
        <ul class="space-y-2">
          <li><a href="/terms" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a></li>
          <li><a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy Policy</a></li>
          <li><a href="/cookies" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Cookie Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t pt-8 text-center text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} Telzee. All rights reserved.</p>
    </div>
  </div>
</footer>

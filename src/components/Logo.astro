---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const heightClasses = { sm: 'h-6', md: 'h-8', lg: 'h-10' };
---

<a href="/" class:list={['flex items-center', className]}>
  <img src="/telzee-logo.svg" alt="Telzee" class:list={[heightClasses[size], 'w-auto']} />
</a>
